rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // Firestore Security Rules - LinguaFlash
    // Đảm bảo mỗi user chỉ truy cập được dữ liệu của chính mình
    // ============================================

    // Users collection - mỗi user chỉ đọc/ghi document của mình
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Folders subcollection - thuộc về user
      match /folders/{folderId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Cards subcollection - thuộc về user
      match /cards/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        // Review logs subcollection
        match /reviewLogs/{logId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Study Sessions subcollection - tracking thời gian học hàng ngày
      match /studySessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Settings subcollection
      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Devices subcollection - FCM push notification tokens
      match /devices/{deviceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
