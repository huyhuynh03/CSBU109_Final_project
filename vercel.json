{
    "version": 2,
    "builds": [
        {
            "src": "api/**/*.js",
            "use": "@vercel/node"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "src": "/sw.js",
            "dest": "/public/sw.js",
            "headers": {
                "Cache-Control": "no-cache, no-store, must-revalidate",
                "Service-Worker-Allowed": "/"
            }
        },
        {
            "src": "/firebase-messaging-sw.js",
            "dest": "/public/firebase-messaging-sw.js",
            "headers": {
                "Cache-Control": "no-cache, no-store, must-revalidate"
            }
        },
        {
            "src": "/manifest.json",
            "dest": "/public/manifest.json",
            "headers": {
                "Cache-Control": "no-cache, max-age=0, must-revalidate"
            }
        },
        {
            "src": "/index.html",
            "dest": "/public/index.html",
            "headers": {
                "Cache-Control": "no-cache, max-age=0, must-revalidate"
            }
        },
        {
            "src": "/icons/(.*)",
            "dest": "/public/icons/$1",
            "headers": {
                "Cache-Control": "public, max-age=2592000"
            }
        },
        {
            "src": "/seed-vocabulary/(.*)",
            "dest": "/public/seed-vocabulary/$1",
            "headers": {
                "Cache-Control": "public, max-age=300, must-revalidate"
            }
        },
        {
            "src": "/src/js/firebase-config.js",
            "dest": "/public/src/js/firebase-config.js",
            "headers": {
                "Cache-Control": "no-cache, no-store, must-revalidate"
            }
        },
        {
            "src": "/src/(.*\\.(?:js|css))",
            "dest": "/public/src/$1",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            }
        },
        {
            "src": "/src/(.*)",
            "dest": "/public/src/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/public/index.html",
            "headers": {
                "Cache-Control": "no-cache, max-age=0, must-revalidate"
            }
        }
    ]
}
