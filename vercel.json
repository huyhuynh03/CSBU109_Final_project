{
    "version": 2,
    "builds": [
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/sw.js",
            "dest": "/public/sw.js",
            "headers": {
                "Cache-Control": "no-cache, no-store, must-revalidate"
            }
        },
        {
            "src": "/manifest.json",
            "dest": "/public/manifest.json",
            "headers": {
                "Cache-Control": "no-cache"
            }
        },
        {
            "src": "/icons/(.*)",
            "dest": "/public/icons/$1"
        },
        {
            "src": "/seed-vocabulary/(.*)",
            "dest": "/public/seed-vocabulary/$1"
        },
        {
            "src": "/src/js/firebase-config.js",
            "dest": "/public/src/js/firebase-config.js",
            "headers": {
                "Cache-Control": "no-cache, no-store, must-revalidate"
            }
        },
        {
            "src": "/src/(.*)",
            "dest": "/public/src/$1",
            "headers": {
                "Cache-Control": "public, max-age=0, must-revalidate"
            }
        },
        {
            "src": "/(.*)",
            "dest": "/public/index.html"
        }
    ]
}
