# ============================================================================
# Mẫu biến môi trường — COPY file này thành `.env` rồi điền key thật.
# ----------------------------------------------------------------------------
#   - File `.env` ĐÃ được .gitignore → không bao giờ lọt vào repo.
#   - File `.env.example` (file này) AN TOÀN để commit vì KHÔNG chứa key thật.
#   - Chỉ dùng lúc generate audio ở máy dev. Key KHÔNG đi vào app/PWA.
#
# Tạo file .env (PowerShell):
#   Copy-Item .env.example .env
# Rồi mở .env, dán key thật vào.
# ============================================================================

# ── Shopaikey (MẶC ĐỊNH — Gemini TTS qua gateway) ────────────────────────────
# Lấy key: Dashboard shopaikey → copy token
# Endpoint TTS: POST https://api.shopaikey.com/tts/google/generations
OPENAI_API_KEY=sk-dan-key-shopaikey-vao-day

# ── Gemini TTS native (tuỳ chọn — gọi trực tiếp Google) ─────────────────────
# Lấy key: https://aistudio.google.com/apikey → Create API Key
# GEMINI_API_KEY=AIza...

# ── Google Cloud TTS (tuỳ chọn — accent US/GB rõ ràng nhất) ──────────────────
# Lấy key: Google Cloud Console → bật "Cloud Text-to-Speech API" → Credentials
# GOOGLE_TTS_API_KEY=AIza...

# ── OpenAI TTS (tuỳ chọn) ────────────────────────────────────────────────────
# Lấy key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── ElevenLabs (tuỳ chọn) ────────────────────────────────────────────────────
# ELEVENLABS_API_KEY=...
